{
  "name": "@hululgroup/spaceship-cli",
  "version": "1.1.0",
  "description": "Production CLI for the Spaceship API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hulul-Group/Spaceship-CLI.git"
  },
  "homepage": "https://github.com/Hulul-Group/Spaceship-CLI#readme",
  "bugs": "https://github.com/Hulul-Group/Spaceship-CLI/issues",
  "type": "module",
  "bin": { "spaceship": "dist/index.js" },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist && cp openapi.json dist/openapi.json",
    "compile": "bun build src/index.ts --compile --outfile=dist/spaceship",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": { "@types/bun": "latest", "typescript": "^5.9.0" },
  "engines": { "bun": ">=1.1.0" },
  "files": ["dist/index.js", "dist/openapi.json", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
